# Copy to .env and fill in the keys. Only endpoints, keys and model names are configured here; the pipeline itself
# has no mode switches. The two choices of the KG extract step are command-line options:
#   --ocr auto|none|cloud         how pages are read (cloud = the vision model below)
#   --llm cloud|local             where KG entity extraction runs (local = the Ollama block below)

# --- LLM: the four agents (Lecture Planner, Packet Builder, Slide Writer, Content QA) ---
LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL_NAME=gpt-4o-mini
# Slide Writer on another model (empty = LLM_MODEL_NAME)
#WRITER_MODEL=

# --- VLM: page OCR in the KG extract step (--ocr cloud / auto on scanned PDFs) ---
VLM_BASE_URL=https://api.openai.com/v1
VLM_API_KEY=your_vlm_api_key_here
VLM_MODEL_NAME=gpt-4o-mini

# --- Embeddings: KG vectors and sentence retrieval (EMBED_BASE_URL / EMBED_API_KEY default to the LLM ones) ---
EMBED_MODEL=text-embedding-3-small
#EMBED_BASE_URL=https://api.openai.com/v1
#EMBED_API_KEY=

# --- KG entity extraction (default: the LLM above with gpt-4o-mini) ---
#KG_LLM_MODEL=gpt-4o-mini

# --- Local LLM for the KG extract step (--llm local): unset values get these defaults ---
# Start Ollama with a context of at least 8192 tokens (the extraction prompt is ~3.7k, ~4.5k with gleaning):
#   OLLAMA_CONTEXT_LENGTH=8192 ollama serve      and      ollama pull <KG_LLM_MODEL>
# The build checks the server, the model and its context first, and stops with what to do.
#KG_LLM_BASE_URL=http://localhost:11434/v1
#KG_LLM_API_KEY=ollama
#KG_LLM_MODEL=qwen3.5:9b
#KG_VLM_BASE_URL=http://localhost:11434/v1
#KG_VLM_API_KEY=ollama
#KG_VLM_MODEL=qwen3.5:9b
#KG_MAX_ASYNC=4

# --- Evaluation (src/evaluation/eval.py, run_benchmark.py) ---
EVAL_LANGUAGE_MODEL=gpt-4.1-mini
EVAL_BASE_URL=https://api.openai.com/v1
EVAL_API_KEY=your_eval_api_key_here
